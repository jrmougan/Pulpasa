{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["godot", "blender"],
  "permissions": {
    "allow": [
      "Bash(godot --headless:*)",
      "Bash(tools/verify.sh:*)",
      "Bash(gdlint:*)",
      "Bash(gdformat:*)",
      "Bash(orca-ide orchestration:*)",
      "Bash(orca orchestration:*)",
      "Bash(orca-ide status:*)",
      "Bash(orca-ide skills get:*)",
      "Bash(orca status:*)",
      "Bash(orca skills get:*)",
      "mcp__godot__check_project",
      "mcp__godot__get_debug_output",
      "mcp__godot__get_project_files",
      "mcp__godot__take_screenshot",
      "mcp__godot__stop_project",
      "mcp__godot__run_project",
      "mcp__godot__simulate_input",
      "mcp__godot__get_ui_elements"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/run_guard.sh\"; [ -s \"$h\" ] || { echo \"Bloqueado: falta o esta vacio el envoltorio: $h\" >&2; exit 2; }; sh \"$h\" || exit 2" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gd_lint_format.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify_on_stop.sh", "timeout": 1500 }]
      }
    ]
  }
}
