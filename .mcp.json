{
  "mcpServers": {
    "godot": {
      "command": "npx",
      "args": [
        "-y",
        "godot-mcp-runtime@3.8.1"
      ],
      "env": {
        "GODOT_MCP_DISABLE_ELICITATION": "true"
      }
    },
    "blender": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git@dbbf836ad4b1025f14a2b3b504c43903f39e0b04#subdirectory=mcp",
        "blender-mcp"
      ],
      "env": {
        "BLENDER_MCP_PORT": "${BLENDER_MCP_PORT:-9876}",
        "BLENDER_PATH": "blender"
      }
    }
  }
}
