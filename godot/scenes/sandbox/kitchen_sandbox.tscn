[sub_resource type="GDScript" id="GDScript_p51g6"]
script/source = "extends Node3D
## Sandbox de cocina de PUL-019: nevera, olla, estantería de cajas, estación de condimentos (PUL-061), un slot libre y
## dos puestos de entrega con un jugador. Arranca la ronda como lo hará `level.gd` (fase 8):
## `OrderService.setup` + `RoundManager.start_round` con los `slot_id` de `stands`.
##
## `rng_seed` != 0 fija las comandas (reproducible); 0 = aleatorias. El `simulate_input` del MCP
## no genera `_unhandled_input`: para capturas se activa `mcp_bridge` en caliente (`run_script`),
## que reenvía `p1_interact` sondeado; está apagado por defecto (como el sandbox de PUL-017).

@export var round_config: RoundConfig
@export var order_catalog: OrderCatalog
@export var stands: Array[OrderStand] = []
@export var interaction: InteractionComponent
@export var rng_seed: int = 0
@export var mcp_bridge: bool = false


func _ready() -> void:
	var rng: RandomNumberGenerator = null
	if rng_seed != 0:
		rng = RandomNumberGenerator.new()
		rng.seed = rng_seed
	OrderService.setup(order_catalog, rng)
	var slot_ids: Array[int] = []
	for stand: OrderStand in stands:
		slot_ids.append(stand.slot_id)
	RoundManager.start_round(round_config, slot_ids)


func _process(_delta: float) -> void:
	if mcp_bridge and interaction != null and Input.is_action_just_pressed(&\"p1_interact\"):
		interaction.interact_pressed()
"

