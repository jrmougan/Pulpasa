; Engine configuration file.
; Pulpasa — Godot 4.7.2. No editar a mano salvo InputMap/autoloads acordados en ADR.

config_version=5

[application]

config/name="Pulpasa"
config/version="0.1.0"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
OrderService="*res://autoload/order_service.gd"
RoundManager="*res://autoload/round_manager.gd"

[debug]

gdscript/warnings/directory_rules={
"res://.mcp": 0,
"res://addons": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

