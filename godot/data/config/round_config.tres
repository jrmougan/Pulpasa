[gd_resource type="Resource" script_class="RoundConfig" load_steps=10 format=3]

[ext_resource type="Script" path="res://resources/round_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://resources/phase_data.gd" id="2_phase"]

[ext_resource type="Resource" path="res://data/orders/a_feira.tres" id="3_o1"]
[ext_resource type="Resource" path="res://data/orders/picante.tres" id="4_o2"]
[ext_resource type="Resource" path="res://data/orders/con_cachelos.tres" id="5_o3"]
[ext_resource type="Resource" path="res://data/orders/bravo_cachelos.tres" id="6_o4"]

[sub_resource type="Resource" id="Resource_phase1"]
script = ExtResource("2_phase")
start_fraction = 0.0
active_slots = 2
patience_multiplier = 1.0
orders = [ExtResource("3_o1")]

[sub_resource type="Resource" id="Resource_phase2"]
script = ExtResource("2_phase")
start_fraction = 0.3333333333333333
active_slots = 3
patience_multiplier = 0.85
orders = [ExtResource("3_o1"), ExtResource("4_o2")]

[sub_resource type="Resource" id="Resource_phase3"]
script = ExtResource("2_phase")
start_fraction = 0.6666666666666666
active_slots = 4
patience_multiplier = 0.7
orders = [ExtResource("3_o1"), ExtResource("4_o2"), ExtResource("5_o3"), ExtResource("6_o4")]

[resource]
script = ExtResource("1_cfg")
duration = 300.0
first_order_delay = 5.0
time_bonus_max = 5
expire_penalty = 3
wrong_delivery_penalty = 0
revenue_thresholds = Array[int]([30, 60, 90])
performance_thresholds = Array[float]([1.0, 2.0, 3.0])
performance_texts = Array[String](["Pulpeiro ineficiente", "Pulpeiro aceptable", "Pulpeiro eficiente", "!Pulpeiro lexendario!"])
phases = Array[ExtResource("2_phase")]([SubResource("Resource_phase1"), SubResource("Resource_phase2"), SubResource("Resource_phase3")])
rng_seed = 0
